# Cloudflare TURN static credentials for the Electron host. Copy to client/.env.
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudflare TURN (Cloudflare Calls) for the overlay renderer.
# WARNING: VITE_* values are inlined into the renderer bundle.
VITE_CLOUDFLARE_TURN_KEY_ID=
VITE_CLOUDFLARE_TURN_API_TOKEN=
