# Cloudflare TURN (Cloudflare Calls). Copy to hosting/.env and fill in.
# WARNING: VITE_* values are inlined into the browser bundle and are public.
# Scope this token to TURN only, and prefer minting short-TTL credentials
# from a Cloud Function instead of shipping the token to clients.
VITE_CLOUDFLARE_TURN_KEY_ID=
VITE_CLOUDFLARE_TURN_API_TOKEN=
